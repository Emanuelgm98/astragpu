<Window x:Class="AstraGPU.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AstraGPU.App" Title="AstraGPU"><Grid Background="#0B1020"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Padding="24" Spacing="12" Background="#10182B"><TextBlock Text="ASTRA GPU" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/><Button Content="Resumen" Click="OnDashboard"/><Button Content="Diagnóstico" Click="OnDiagnostics"/><Button Content="Biblioteca" Click="OnLibrary"/><Button Content="Perfiles" Click="OnProfiles"/><Button Content="Benchmark" Click="OnBenchmark"/><Button Content="Streaming" Click="OnStreaming"/><TextBlock Text="Local · Privado · Transparente" Foreground="#91A4C8" Margin="0,24,0,0" TextWrapping="Wrap"/></StackPanel><ScrollViewer Grid.Column="1"><StackPanel Padding="36" Spacing="16"><TextBlock x:Name="Heading" Text="Optimización local, con evidencia" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="Subheading" Text="Sin promesas universales de FPS. Tú decides qué cambiar." FontSize="16" Foreground="#B7C5DE"/><Border Background="#121C31" CornerRadius="12" Padding="20"><StackPanel Spacing="12"><TextBlock x:Name="ContentTitle" Text="Tu PC, tal como está" FontSize="21"/><TextBlock x:Name="Content" Text="Diagnostica el equipo, organiza tus juegos y revisa mediciones reales. AstraGPU no instala controladores, no altera voltajes y no toca antivirus, firewall ni anti-cheat." TextWrapping="WrapWholeWords" FontSize="15"/><Button x:Name="ActionButton" Content="Ejecutar diagnóstico local" HorizontalAlignment="Left" Click="OnAction"/></StackPanel></Border><TextBlock x:Name="Status" Foreground="#89D5B0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></Window>
